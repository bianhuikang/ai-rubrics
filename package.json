{
  "name": "ai-rubrics-judge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next']) fs.rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "next": "15.1.6",
    "playwright": "^1.49.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "^5.7.3"
  }
}
